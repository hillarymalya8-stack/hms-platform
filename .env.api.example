# Hosted API
# Railway/Render usually sets PORT automatically. API_PORT is useful locally.
API_PORT=4000

# Hosted Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Comma-separated web origins allowed to call the API.
# Example: https://your-hms-web.netlify.app,https://yourdomain.com
WEB_ORIGIN=http://localhost:3000

# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h
