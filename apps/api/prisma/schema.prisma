generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum RoleScope {
  ORGANIZATION
  PROPERTY
}

enum BusinessDateStatus {
  OPEN
  CLOSED
  REOPENED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SALES
  EXPENSE
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
  VOID
}

enum RoomHousekeepingStatus {
  DIRTY
  CLEAN
  INSPECTED
}

enum RoomOccupancyStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
}

enum RoomMaintenanceStatus {
  AVAILABLE
  OUT_OF_SERVICE
  OUT_OF_ORDER
}

enum ReservationStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum FolioStatus {
  OPEN
  SETTLED
  CLOSED
  VOID
}

enum FolioItemType {
  ROOM_CHARGE
  POS_CHARGE
  PAYMENT
  DEPOSIT
  DISCOUNT
  TAX
  REFUND
  TRANSFER
  OTHER
}

enum PosOutletType {
  RESTAURANT
  BAR
  ROOM_SERVICE
  SPA
  OTHER
}

enum ProductType {
  STOCKED
  NON_STOCKED
  SERVICE
}

enum DiningTableStatus {
  AVAILABLE
  SEATED
  ORDER_OPEN
  OUT_OF_SERVICE
}

enum CashierShiftStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum PosOrderStatus {
  OPEN
  HELD
  PAID
  VOID
  REFUNDED
}

enum PosServiceType {
  DINE_IN
  TAKEAWAY
  ROOM_SERVICE
  BAR
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
  MOBILE_MONEY
  BANK_TRANSFER
  ROOM_CHARGE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  VOID
  REFUNDED
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  COUNT_VARIANCE
}

enum InventoryMovementStatus {
  DRAFT
  POSTED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum SupplierInvoiceStatus {
  DRAFT
  MATCHED
  POSTED
  PAID
  VOID
}

enum ReportExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum OfflineTerminalStatus {
  ONLINE
  OFFLINE
  SYNCING
}

enum OfflineSyncEventStatus {
  QUEUED
  SYNCED
  CONFLICT
  FAILED
}

model Organization {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  accounts               Account[]
  auditLogs              AuditLog[]
  guests                 Guest[]
  persistenceTransitions PersistenceTransition[]
  properties             Property[]
  roles                  Role[]
  users                  User[]

  @@map("organizations")
}

model Property {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  name           String
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountMappings        AccountMapping[]
  accounts               Account[]
  auditLogs              AuditLog[]
  businessDates          BusinessDate[]
  defaultUsers           User[]                  @relation("UserDefaultProperty")
  departments            Department[]
  financialPeriods       FinancialPeriod[]
  floors                 Floor[]
  folios                 Folio[]
  guests                 Guest[]
  inventoryItems         InventoryItem[]
  inventoryLocations     InventoryLocation[]
  inventoryMovements     InventoryMovement[]
  journalEntries         JournalEntry[]
  offlineSyncEvents      OfflineSyncEvent[]
  offlineTerminals       OfflineTerminal[]
  payments               Payment[]
  persistenceTransitions PersistenceTransition[]
  posOutlets             PosOutlet[]
  posOrders              PosOrder[]
  productCategories      ProductCategory[]
  products               Product[]
  propertySettings       PropertySetting?
  purchaseOrders         PurchaseOrder[]
  reportExports          ReportExport[]
  reservations           Reservation[]
  roomTypes              RoomType[]
  rooms                  Room[]
  roles                  Role[]
  suppliers              Supplier[]
  supplierInvoices       SupplierInvoice[]
  userRoles              UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("properties")
}

model PropertySetting {
  id                String   @id @default(uuid()) @db.Uuid
  propertyId        String   @unique @map("property_id") @db.Uuid
  currencyCode      String   @default("USD") @map("currency_code")
  currencySymbol    String   @default("$") @map("currency_symbol")
  currencyPrecision Int      @default(2) @map("currency_precision")
  fiscalYearStart   DateTime @map("fiscal_year_start") @db.Date
  checkInTime       String   @default("14:00") @map("check_in_time")
  checkOutTime      String   @default("11:00") @map("check_out_time")
  numberingRules    Json     @default("{}") @map("numbering_rules")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_settings")
}

model Department {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @map("property_id") @db.Uuid
  code       String
  name       String
  active     Boolean      @default(true)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  posOutlets   PosOutlet[]

  @@unique([propertyId, code])
  @@index([propertyId, active])
  @@map("departments")
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  defaultPropertyId String?      @map("default_property_id") @db.Uuid
  email             String       @unique
  passwordHash      String       @map("password_hash")
  fullName          String       @map("full_name")
  mfaEnabled        Boolean      @default(false) @map("mfa_enabled")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  defaultProperty        Property?               @relation("UserDefaultProperty", fields: [defaultPropertyId], references: [id], onDelete: SetNull)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditLogs              AuditLog[]
  cashierShifts          CashierShift[]
  closedBusinessDates    BusinessDate[]          @relation("ClosedBusinessDates")
  closedFinancialPeriods FinancialPeriod[]       @relation("ClosedFinancialPeriods")
  openedBusinessDates    BusinessDate[]          @relation("OpenedBusinessDates")
  persistenceTransitions PersistenceTransition[]
  sessions               UserSession[]
  userRoles              UserRole[]

  @@index([organizationId, status])
  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenHash])
  @@map("user_sessions")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String?   @map("property_id") @db.Uuid
  name           String
  scope          RoleScope @default(PROPERTY)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property        Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, propertyId, name])
  @@index([organizationId, scope])
  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  module    String
  action    String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  propertyId String?  @map("property_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, propertyId])
  @@index([userId, propertyId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model BusinessDate {
  id           String             @id @default(uuid()) @db.Uuid
  propertyId   String             @map("property_id") @db.Uuid
  businessDate DateTime           @map("business_date") @db.Date
  status       BusinessDateStatus @default(OPEN)
  openedById   String?            @map("opened_by_id") @db.Uuid
  closedById   String?            @map("closed_by_id") @db.Uuid
  openedAt     DateTime           @default(now()) @map("opened_at")
  closedAt     DateTime?          @map("closed_at")

  closedBy User?    @relation("ClosedBusinessDates", fields: [closedById], references: [id], onDelete: SetNull)
  openedBy User?    @relation("OpenedBusinessDates", fields: [openedById], references: [id], onDelete: SetNull)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, businessDate])
  @@index([propertyId, status])
  @@map("business_dates")
}

model RoomType {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  code          String
  name          String
  baseOccupancy Int      @default(1) @map("base_occupancy")
  maxOccupancy  Int      @default(2) @map("max_occupancy")
  baseRate      Decimal  @default(0) @map("base_rate") @db.Decimal(18, 4)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationRooms ReservationRoom[]
  rooms            Room[]

  @@unique([propertyId, code])
  @@index([propertyId, active])
  @@map("room_types")
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([propertyId, name])
  @@index([propertyId, sortOrder])
  @@map("floors")
}

model Room {
  id                 String                 @id @default(uuid()) @db.Uuid
  propertyId         String                 @map("property_id") @db.Uuid
  roomTypeId         String                 @map("room_type_id") @db.Uuid
  floorId            String?                @map("floor_id") @db.Uuid
  roomNumber         String                 @map("room_number")
  housekeepingStatus RoomHousekeepingStatus @default(CLEAN) @map("housekeeping_status")
  occupancyStatus    RoomOccupancyStatus    @default(AVAILABLE) @map("occupancy_status")
  maintenanceStatus  RoomMaintenanceStatus  @default(AVAILABLE) @map("maintenance_status")
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  floor            Floor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType         RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservationRooms ReservationRoom[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, roomTypeId])
  @@index([propertyId, housekeepingStatus, occupancyStatus, maintenanceStatus])
  @@map("rooms")
}

model Guest {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  propertyId     String?      @map("property_id") @db.Uuid
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  documentNumber String?      @map("document_number")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property            Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  folios              Folio[]
  primaryReservations Reservation[]      @relation("PrimaryGuestReservations")
  reservationGuests   ReservationGuest[]

  @@unique([organizationId, email])
  @@index([organizationId, lastName, firstName])
  @@index([propertyId, status])
  @@map("guests")
}

model Reservation {
  id                String            @id @default(uuid()) @db.Uuid
  propertyId        String            @map("property_id") @db.Uuid
  primaryGuestId    String            @map("primary_guest_id") @db.Uuid
  reservationNumber String            @map("reservation_number")
  arrivalDate       DateTime          @map("arrival_date") @db.Date
  departureDate     DateTime          @map("departure_date") @db.Date
  adults            Int               @default(1)
  children          Int               @default(0)
  status            ReservationStatus @default(CONFIRMED)
  bookingSource     String?           @map("booking_source")
  notes             String?
  depositRequired   Decimal           @default(0) @map("deposit_required") @db.Decimal(18, 4)
  depositPaid       Decimal           @default(0) @map("deposit_paid") @db.Decimal(18, 4)
  checkedInAt       DateTime?         @map("checked_in_at")
  checkedOutAt      DateTime?         @map("checked_out_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  folios            Folio[]
  primaryGuest      Guest              @relation("PrimaryGuestReservations", fields: [primaryGuestId], references: [id], onDelete: Restrict)
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationGuests ReservationGuest[]
  reservationRooms  ReservationRoom[]

  @@unique([propertyId, reservationNumber])
  @@index([propertyId, arrivalDate, departureDate, status])
  @@index([primaryGuestId, status])
  @@map("reservations")
}

model ReservationRoom {
  id            String            @id @default(uuid()) @db.Uuid
  reservationId String            @map("reservation_id") @db.Uuid
  roomTypeId    String            @map("room_type_id") @db.Uuid
  roomId        String?           @map("room_id") @db.Uuid
  ratePlanCode  String?           @map("rate_plan_code")
  nightlyRate   Decimal           @default(0) @map("nightly_rate") @db.Decimal(18, 4)
  status        ReservationStatus @default(CONFIRMED)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  reservation Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  roomType    RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  guests      ReservationGuest[]

  @@index([roomId, status])
  @@index([roomTypeId, status])
  @@index([reservationId])
  @@map("reservation_rooms")
}

model ReservationGuest {
  reservationId     String  @map("reservation_id") @db.Uuid
  guestId           String  @map("guest_id") @db.Uuid
  reservationRoomId String? @map("reservation_room_id") @db.Uuid
  guestRole         String  @default("guest") @map("guest_role")

  guest           Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservation     Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationRoom ReservationRoom? @relation(fields: [reservationRoomId], references: [id], onDelete: SetNull)

  @@id([reservationId, guestId])
  @@index([guestId])
  @@map("reservation_guests")
}

model Folio {
  id            String      @id @default(uuid()) @db.Uuid
  propertyId    String      @map("property_id") @db.Uuid
  reservationId String      @map("reservation_id") @db.Uuid
  guestId       String      @map("guest_id") @db.Uuid
  folioNumber   String      @map("folio_number")
  status        FolioStatus @default(OPEN)
  balance       Decimal     @default(0) @db.Decimal(18, 4)
  openedAt      DateTime    @default(now()) @map("opened_at")
  closedAt      DateTime?   @map("closed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)
  items       FolioItem[]
  posOrders   PosOrder[]
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([propertyId, folioNumber])
  @@index([propertyId, guestId, status])
  @@index([reservationId, status])
  @@map("folios")
}

model FolioItem {
  id             String        @id @default(uuid()) @db.Uuid
  folioId        String        @map("folio_id") @db.Uuid
  itemType       FolioItemType @map("item_type")
  sourceType     String?       @map("source_type")
  sourceId       String?       @map("source_id")
  description    String
  quantity       Decimal       @default(1) @db.Decimal(18, 4)
  unitPrice      Decimal       @default(0) @map("unit_price") @db.Decimal(18, 4)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(18, 4)
  postedAt       DateTime      @default(now()) @map("posted_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId, postedAt])
  @@index([sourceType, sourceId])
  @@map("folio_items")
}

model PosOutlet {
  id                      String        @id @default(uuid()) @db.Uuid
  propertyId              String        @map("property_id") @db.Uuid
  departmentId            String?       @map("department_id") @db.Uuid
  name                    String
  outletType              PosOutletType @default(RESTAURANT) @map("outlet_type")
  defaultRevenueAccountId String?       @map("default_revenue_account_id") @db.Uuid
  active                  Boolean       @default(true)
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  cashDrawers      CashDrawer[]
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  orders           PosOrder[]
  outletProducts   OutletProduct[]
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  offlineTerminals OfflineTerminal[]
  shifts           CashierShift[]
  tables           DiningTable[]
  terminals        PosTerminal[]

  @@unique([propertyId, name])
  @@index([propertyId, outletType, active])
  @@map("pos_outlets")
}

model PosTerminal {
  id               String    @id @default(uuid()) @db.Uuid
  outletId         String    @map("outlet_id") @db.Uuid
  name             String
  deviceIdentifier String    @map("device_identifier")
  syncStatus       String    @default("ONLINE") @map("sync_status")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  cashDrawers CashDrawer[]
  outlet      PosOutlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders      PosOrder[]
  shifts      CashierShift[]

  @@unique([outletId, deviceIdentifier])
  @@index([outletId, syncStatus])
  @@map("pos_terminals")
}

model CashDrawer {
  id         String   @id @default(uuid()) @db.Uuid
  outletId   String   @map("outlet_id") @db.Uuid
  terminalId String?  @map("terminal_id") @db.Uuid
  name       String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  outlet   PosOutlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  terminal PosTerminal?   @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  shifts   CashierShift[]

  @@unique([outletId, name])
  @@index([terminalId])
  @@map("cash_drawers")
}

model CashierShift {
  id           String             @id @default(uuid()) @db.Uuid
  outletId     String             @map("outlet_id") @db.Uuid
  terminalId   String             @map("terminal_id") @db.Uuid
  drawerId     String             @map("drawer_id") @db.Uuid
  cashierId    String             @map("cashier_id") @db.Uuid
  openingCash  Decimal            @default(0) @map("opening_cash") @db.Decimal(18, 4)
  expectedCash Decimal            @default(0) @map("expected_cash") @db.Decimal(18, 4)
  actualCash   Decimal?           @map("actual_cash") @db.Decimal(18, 4)
  variance     Decimal?           @db.Decimal(18, 4)
  status       CashierShiftStatus @default(OPEN)
  openedAt     DateTime           @default(now()) @map("opened_at")
  closedAt     DateTime?          @map("closed_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  cashier  User        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  drawer   CashDrawer  @relation(fields: [drawerId], references: [id], onDelete: Restrict)
  orders   PosOrder[]
  outlet   PosOutlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  payments Payment[]
  terminal PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Restrict)

  @@index([outletId, status])
  @@index([cashierId, status])
  @@map("cashier_shifts")
}

model ProductCategory {
  id                 String   @id @default(uuid()) @db.Uuid
  propertyId         String   @map("property_id") @db.Uuid
  parentId           String?  @map("parent_id") @db.Uuid
  name               String
  revenueAccountId   String?  @map("revenue_account_id") @db.Uuid
  costAccountId      String?  @map("cost_account_id") @db.Uuid
  inventoryAccountId String?  @map("inventory_account_id") @db.Uuid
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  children ProductCategory[] @relation("ProductCategoryTree")
  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  products Product[]
  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@index([propertyId, active])
