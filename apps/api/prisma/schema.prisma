  reversedEntry      JournalEntry?       @relation("JournalReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversal           JournalEntry?       @relation("JournalReversal")
  inventoryMovements InventoryMovement[]
  lines              JournalLine[]
  supplierInvoices   SupplierInvoice[]

  @@unique([propertyId, entryNumber])
  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, sourceType, sourceId])
  @@index([financialPeriodId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  debitAmount    Decimal  @default(0) @map("debit_amount") @db.Decimal(18, 4)
  creditAmount   Decimal  @default(0) @map("credit_amount") @db.Decimal(18, 4)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([departmentId])
  @@map("journal_lines")
}
